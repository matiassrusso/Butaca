TMDB_API_KEY=
NVIDIA_API_KEY=
RESEND_API_KEY=
# Remitente. El default (onboarding@resend.dev) es el sandbox de Resend y solo
# puede mandar mails a tu propia casilla — para usuarios reales hace falta un
# dominio verificado en Resend, ej. "Butaca <no-reply@butaca.xyz>".
RESEND_FROM_EMAIL=
BUTACA_DEBUG=
# Client ID de OAuth (tipo "Aplicación web") de Google Cloud Console. No es un
# secreto — el mismo valor va al frontend como VITE_GOOGLE_CLIENT_ID — pero el
# backend lo necesita para validar el `aud` del ID token: sin eso, un token
# emitido para otra app de Google entraría como usuario válido.
# Si queda vacío, /auth/google devuelve 503 y el botón no se muestra.
GOOGLE_CLIENT_ID=
